{
  "name": "carshop-server",
  "version": "1.0.0",
  "description": "Enterprise Car Dealership Backend API built with Node.js, Express, and TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seeds/seed.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "enterprise",
    "layered-architecture",
    "carshop",
    "rest-api"
